# ============================================================================
# HDA STUDIO - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# ============================================================================
# STRIPE CONFIGURATION (Required for payments)
# ============================================================================
# Publishable key is safe for frontend (starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"

# Secret key - ADD TO SUPABASE EDGE FUNCTION SECRETS, NOT HERE
# STRIPE_SECRET_KEY should be set in Supabase Dashboard > Edge Functions > Secrets

# ============================================================================
# OPENAI CONFIGURATION (Optional - for AI features)
# ============================================================================
# ADD TO SUPABASE EDGE FUNCTION SECRETS, NOT HERE
# OPENAI_API_KEY should be set in Supabase Dashboard > Edge Functions > Secrets

# ============================================================================
# BUSINESS INFORMATION (SEO & Schema.org)
# ============================================================================
VITE_BUSINESS_NAME="HDA Studio"
VITE_BUSINESS_PHONE="(832) 907-0199"
VITE_BUSINESS_EMAIL="hello@hdastudio.com"
VITE_SITE_URL="https://hda-studio.com"
