# ============================================================================
# HDA STUDIO - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control - only commit .env.example
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
# Project ID: Found in Project Settings > General
# URL: Your project's API URL (e.g., https://xxxxx.supabase.co)
# Publishable Key: Can be safely exposed in client-side code
# Service Role Key: NEVER expose in client-side code - server only!
# ============================================================================

VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-side only (if using API routes/edge functions)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================================
# OPENAI CONFIGURATION (for AI-powered features)
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Used for: Gallery AI auto-tagging, image descriptions, content generation
# Note: OpenAI keys should be kept server-side (Supabase Edge Functions)
# ============================================================================

# For client-side (if needed - NOT recommended)
# VITE_OPENAI_API_KEY=sk-...

# For server-side (Supabase Edge Functions - RECOMMENDED)
# Add this to Supabase Dashboard > Project Settings > Edge Functions > Secrets
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORGANIZATION_ID=org-your-organization-id-here
OPENAI_MODEL=gpt-4o

# ============================================================================
# STRIPE CONFIGURATION (for payments)
# ============================================================================
# Get your keys from: https://dashboard.stripe.com/apikeys
# Publishable Key: Safe to expose in client-side code
# Secret Key: NEVER expose in client-side code - server only!
# ============================================================================

# Client-side (safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Server-side only (NEVER expose in client)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook configuration (for Supabase Edge Functions)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: Stripe product/price IDs for quick reference
STRIPE_DEPOSIT_PRODUCT_ID=prod_your_deposit_product_id
STRIPE_FULL_PAYMENT_PRODUCT_ID=prod_your_full_payment_product_id

# ============================================================================
# GOOGLE SERVICES (Optional)
# ============================================================================
# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps API (for location services)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Tag Manager (optional)
VITE_GTM_ID=GTM-XXXXXXX

# Google Cloud Vision API (alternative to OpenAI for image analysis)
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id

# ============================================================================
# SOCIAL MEDIA API KEYS (Optional)
# ============================================================================
# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# Facebook Graph API
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# ============================================================================
# EMAIL SERVICES (Optional)
# ============================================================================
# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_TEMPLATE_ID_BOOKING_CONFIRMATION=d-your-template-id

# Resend (alternative)
RESEND_API_KEY=re_your_resend_api_key_here

# MailChimp (newsletter)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_LIST_ID=your_list_id_here

# ============================================================================
# SMS SERVICES (Optional)
# ============================================================================
# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================================
# Sentry (error tracking)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# LogRocket (session replay)
VITE_LOGROCKET_APP_ID=your_logrocket_app_id/project-name

# Mixpanel (product analytics)
VITE_MIXPANEL_TOKEN=your_mixpanel_token_here

# ============================================================================
# BUSINESS INFORMATION (for SEO and Schema.org)
# ============================================================================
VITE_BUSINESS_NAME="HDA Studio"
VITE_BUSINESS_PHONE="+1-XXX-XXX-XXXX"
VITE_BUSINESS_EMAIL="info@hdastudio.com"
VITE_BUSINESS_ADDRESS_STREET="123 Beauty Lane"
VITE_BUSINESS_ADDRESS_CITY="Los Angeles"
VITE_BUSINESS_ADDRESS_STATE="CA"
VITE_BUSINESS_ADDRESS_ZIP="90001"
VITE_BUSINESS_ADDRESS_COUNTRY="US"
VITE_BUSINESS_LATITUDE="34.0522"
VITE_BUSINESS_LONGITUDE="-118.2437"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment (development, staging, production)
VITE_APP_ENV=development

# Site URL (for canonical URLs, Open Graph, etc.)
VITE_SITE_URL=http://localhost:5173

# CDN URL (if using a CDN)
VITE_CDN_URL=https://cdn.yourdomain.com

# API Rate Limiting
VITE_API_RATE_LIMIT=100

# Image optimization
VITE_MAX_IMAGE_SIZE_MB=10
VITE_IMAGE_QUALITY=80
VITE_IMAGE_MAX_WIDTH=2000

# ============================================================================
# FEATURE FLAGS (Optional)
# ============================================================================
VITE_ENABLE_AI_TAGGING=true
VITE_ENABLE_STRIPE_PAYMENTS=true
VITE_ENABLE_GOOGLE_ANALYTICS=true
VITE_ENABLE_SOCIAL_FEEDS=true
VITE_ENABLE_BOOKING_SYSTEM=true
VITE_ENABLE_REVIEWS=true

# ============================================================================
# DEVELOPMENT/DEBUG FLAGS
# ============================================================================
VITE_DEBUG_MODE=false
VITE_SHOW_CONSOLE_LOGS=false
VITE_ENABLE_MOCK_DATA=false

# ============================================================================
# SECURITY
# ============================================================================
# JWT Secret (for custom auth - if not using Supabase Auth)
JWT_SECRET=your_jwt_secret_here_min_32_chars

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ============================================================================
# NOTES
# ============================================================================
# 1. All VITE_ prefixed variables are exposed to the client-side code
# 2. Variables without VITE_ prefix are server-side only
# 3. Never commit .env file to version control
# 4. Keep .env file in .gitignore
# 5. Update this .env.example file when adding new variables
# 6. Use strong, unique values for all secret keys
# 7. Rotate keys regularly for security
# ============================================================================
